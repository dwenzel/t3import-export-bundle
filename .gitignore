# Extension working copies (separate git repositories)
/packages/*
!/packages/.gitkeep

# Per-instance build output
/instances/*/vendor/
/instances/*/var/
/instances/*/public/*
!/instances/*/public/typo3conf/
/instances/*/public/typo3conf/*
!/instances/*/public/typo3conf/AdditionalConfiguration.php
/instances/*/config/system/settings.php
/instances/*/public/typo3conf/LocalConfiguration.php
/instances/*/public/typo3conf/PackageStates.php
/instances/*/composer.lock
# Written by "typo3 setup --create-site" (TYPO3 >= 14)
/instances/*/config/sites/*/setup.typoscript

# Generated DDEV configuration (active TYPO3 version)
/.ddev/config.zz-version.yaml

# Tooling caches
/.build/
/.php-cs-fixer.cache
/.phpunit.result.cache

# Local editor / agent settings
/.idea/
**/.claude/settings.local.json
.DS_Store
