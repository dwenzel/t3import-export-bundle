{
    "name": "dwenzel/t3import-export-instance-v13",
    "description": "TYPO3 13 instance for developing cpsit/t3import_export (extension branch: feature/v13compatible)",
    "license": "GPL-2.0-or-later",
    "type": "project",
    "require": {
        "cpsit/import-export-core": "@dev",
        "cpsit/t3import_export": "@dev",
        "helhum/typo3-console": "^8.3 || ^9.0",
        "typo3/cms-backend": "^13.4",
        "typo3/cms-belog": "^13.4",
        "typo3/cms-beuser": "^13.4",
        "typo3/cms-core": "^13.4",
        "typo3/cms-extbase": "^13.4",
        "typo3/cms-filelist": "^13.4",
        "typo3/cms-fluid": "^13.4",
        "typo3/cms-fluid-styled-content": "^13.4",
        "typo3/cms-frontend": "^13.4",
        "typo3/cms-info": "^13.4",
        "typo3/cms-install": "^13.4",
        "typo3/cms-lowlevel": "^13.4",
        "typo3/cms-scheduler": "^13.4",
        "typo3/cms-setup": "^13.4",
        "typo3/cms-tstemplate": "^13.4"
    },
    "repositories": {
        "packages": {
            "type": "path",
            "url": "../../packages/*",
            "options": {
                "symlink": true
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "helhum/typo3-console-plugin": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.3"
        }
    },
    "extra": {
        "typo3/cms": {
            "web-dir": "public"
        }
    },
    "scripts": {
        "bundle:setup": "../shared/bin/setup-instance 13"
    },
    "scripts-descriptions": {
        "bundle:setup": "Create the database and install TYPO3 non-interactively"
    }
}
