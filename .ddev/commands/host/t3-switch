#!/usr/bin/env bash

## Description: Switch the active TYPO3 version (PHP, docroot, database, extension branch)
## Usage: t3-switch [major] [--keep-branch] [--no-setup]
## Example: "ddev t3-switch" (show current), "ddev t3-switch 12", "ddev t3-switch 11 --keep-branch"
## Flags: [{"Name":"keep-branch","Usage":"Do not check out the extension branch mapped to this version"},{"Name":"no-setup","Usage":"Only reconfigure and restart, skip composer install and TYPO3 setup"}]

set -euo pipefail

versions_file="${DDEV_APPROOT}/.ddev/versions"
generated_file="${DDEV_APPROOT}/.ddev/config.zz-version.yaml"
default_version=13

major=""
keep_branch=0
run_setup=1
for arg in "$@"; do
    case "${arg}" in
        --keep-branch) keep_branch=1 ;;
        --no-setup) run_setup=0 ;;
        -*) echo "Unknown option: ${arg}" >&2; exit 2 ;;
        *) major="${arg#v}" ;;
    esac
done

current_version() {
    if [ -f "${generated_file}" ]; then
        sed -n 's/^# t3-switch version: //p' "${generated_file}"
    else
        echo "${default_version}"
    fi
}

list_versions() {
    local current
    current="$(current_version)"
    echo "Available TYPO3 versions (active: ${current}):"
    grep -vE '^\s*(#|$)' "${versions_file}" | while read -r v php branch; do
        marker=" "
        [ "${v}" = "${current}" ] && marker="*"
        printf ' %s %-3s PHP %-4s extension branch: %s\n' "${marker}" "${v}" "${php}" "${branch}"
    done
}

if [ -z "${major}" ]; then
    list_versions
    exit 0
fi

line="$(grep -E "^${major}[[:space:]]" "${versions_file}" || true)"
if [ -z "${line}" ]; then
    echo "TYPO3 version '${major}' is not configured in .ddev/versions." >&2
    list_versions >&2
    exit 1
fi
read -r _ php_version branch <<<"${line}"

if [ ! -f "${DDEV_APPROOT}/instances/v${major}/composer.json" ]; then
    echo "instances/v${major}/composer.json is missing." >&2
    exit 1
fi

# Check out the extension branch first: it refuses on uncommitted changes,
# and nothing has been reconfigured at that point.
if [ "${keep_branch}" -eq 0 ]; then
    "${DDEV_APPROOT}/.ddev/commands/host/ext-checkout" "${branch}"
fi

cat > "${generated_file}" <<EOF
# t3-switch version: ${major}
# Generated by 'ddev t3-switch ${major}'. Do not edit, do not commit.
php_version: "${php_version}"
docroot: instances/v${major}/public
composer_root: instances/v${major}
web_environment:
    - TYPO3_INSTANCE_DB=t3_v${major}
    - TYPO3_INSTANCE_VERSION=${major}
EOF

echo "Switching to TYPO3 ${major} (PHP ${php_version})"
ddev restart

if [ "${run_setup}" -eq 1 ]; then
    ddev composer install --no-interaction --no-progress
    ddev composer bundle:setup
fi

echo "Active: TYPO3 ${major}, PHP ${php_version}, extension branch: $(git -C "${DDEV_APPROOT}/packages/t3import_export" rev-parse --abbrev-ref HEAD 2>/dev/null || echo 'not checked out')"
